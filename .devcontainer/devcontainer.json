{
  "name": "CWU Cyber Kali GUI",
  "build": { "dockerfile": "Dockerfile" },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "CWU Kali GUI",
      "onAutoForward": "openBrowser"
    }
  },
  "remoteUser": "kali",
  "postStartCommand": "bash -lc 'nohup /usr/local/bin/start-cwu-kali-gui >/tmp/cwu-gui.log 2>&1 &'"
}
